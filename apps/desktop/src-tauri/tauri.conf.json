{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FireflyCompanion",
  "version": "0.2.0-alpha.55",
  "identifier": "com.firefly.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "C:\\Users\\Fireflylover\\AppData\\Roaming\\npm\\pnpm.cmd dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "流萤桌面伴侣",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": false
      },
      {
        "label": "pet",
        "title": "流萤桌宠",
        "width": 220,
        "height": 340,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "x": 80,
        "y": 100
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://100.111.201.71:8765; media-src 'self' data: blob: http://100.111.201.71:8765; connect-src 'self' ipc: http://ipc.localhost http://100.111.201.71:8765 ws://100.111.201.71:8767 http://127.0.0.1:8765 ws://127.0.0.1:8767; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {}
    },
    "linux": {
      "deb": {},
      "appimage": {}
    }
  },
  "plugins": {}
}
