resources/voice/gpt_sovits_engine/GPT_SoVITS/pretrained_models/
resources/voice/gpt_sovits_engine/GPT_weights_v4/
resources/voice/gpt_sovits_engine/SoVITS_weights_v4/

# 语音合成缓存与引擎运行日志
data/audio_cache/
resources/voice/gpt_sovits_engine/logs/
resources/voice/gpt_sovits_engine/*.log

# Python 虚拟环境（运行时创建，不纳入版本库）
resources/voice/gpt_sovits_engine/env/

