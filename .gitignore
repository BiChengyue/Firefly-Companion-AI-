node_modules/
.venv/
__pycache__/
*.pyc

# 构建产物
dist/
target/
apps/desktop/src-tauri/target/

# 运行时数据（向量库/对话/日志）
data/
server.log

# 本地配置（含密钥，不要提交）
config/*.local.json
config/default.json
.env

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/

# 个人开发文档 (不提交)
开发思路.md

# 流萤专属权重 (走 Git LFS 提交，克隆后自动下载，无需忽略)
# *.ckpt 和 *.pth 已在 .gitattributes 中设为 LFS 追踪

# 参考音频：小文件，直接提交
# resources/voice/firefly/ref_audio/ 不忽略

